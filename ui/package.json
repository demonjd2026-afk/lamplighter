{
  "name": "lamplighter-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Source of the Lamplighter dashboard. `npm run build` writes the bundle that the Python package serves.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2020 --legal-comments=none --outfile=../src/lamplighter/static/app.bundle.js"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "esbuild": "^0.25.0",
    "three": "^0.170.0"
  }
}
