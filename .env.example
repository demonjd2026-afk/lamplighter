# Copy to .env and export, or set these in your process manager. Never commit real values.

# Required
LAMPLIGHTER_CONTROLPLANE_URL=http://127.0.0.1:9100
LAMPLIGHTER_CONTROLPLANE_TOKEN=change-me-to-a-long-random-string

# Where telemetry (JSON-lines adapter) and incident artefacts live
LAMPLIGHTER_DATA_DIR=./data
LAMPLIGHTER_PROFILE=production            # production (5 min / 1 h windows) or demo (seconds)
LAMPLIGHTER_POLICY_FILE=./demo/policy.toml # without a policy file the system only proposes

# API. Routes whose secret is empty are disabled.
LAMPLIGHTER_API_TOKEN=                    # at least 24 characters; needed to approve or reject plans
LAMPLIGHTER_WEBHOOK_SECRET=               # at least 24 characters; HMAC secret for POST /v1/alerts
LAMPLIGHTER_PUBLIC_READ=0                 # 1 allows reads without a token; only honoured on loopback
LAMPLIGHTER_HOST=127.0.0.1
LAMPLIGHTER_PORT=8088
LAMPLIGHTER_ALLOWED_HOSTS=                # extra hosts the worker may call, comma separated (https only)

# Optional language model. Everything works without it.
LAMPLIGHTER_LLM_PROVIDER=                 # anthropic | openai (any OpenAI-compatible endpoint)
LAMPLIGHTER_LLM_MODEL=                    # the model id from your provider; there is no default
LAMPLIGHTER_LLM_API_KEY=
LAMPLIGHTER_LLM_BASE_URL=                 # optional override
LAMPLIGHTER_ANTHROPIC_VERSION=2026-10-21
LAMPLIGHTER_LLM_PATCH=0                   # 1 lets the model propose a patch (sandbox-verified, never deployed)
LAMPLIGHTER_RELEASES_ROOT=                # release sources, for the fix-forward brief
LAMPLIGHTER_NOTIFY_URL=                   # optional webhook for approvals and closures
